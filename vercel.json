{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/p/:id", "destination": "/api/download?id=:id" },
    { "source": "/i/:id", "destination": "/api/image?id=:id" }
  ],
  "functions": {
    "api/banana.js": {
      "maxDuration": 300,
      "includeFiles": "{lib/logos/**,public/assets/logos/**}"
    },
    "api/download.js": { "maxDuration": 30 },
    "api/image.js": { "maxDuration": 30 },
    "api/unlock.js": { "maxDuration": 30 },
    "api/leads.js": { "maxDuration": 30 },
    "api/send-photo.js": { "maxDuration": 30 },
    "api/health.js": { "maxDuration": 15 },
    "api/qr.js": { "maxDuration": 15 }
  }
}
